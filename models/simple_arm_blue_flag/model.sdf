<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="simple_arm_blue_flag">
    <include>
      <uri>model://simple_arm_gripper</uri>
    </include>

    <include>
      <uri>model://blue_flag</uri>
      <pose>1.98 0 1.05 0 0 0</pose>
    </include>

    <joint name="blue_flag_to_gripper" type="fixed">
      <parent>simple_arm_gripper::simple_gripper::palm</parent>
      <child>blue_flag::pole</child>
    </joint>
  </model>
</sdf>
